{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name} (Fabric)",
  "description": "Fabric bootstrap for the Pandoras Creatures common core.",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {},
  "license": "${mod_license}",
  "icon": "assets/pandoras_creatures/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "andrews.pandoras_creatures.PandorasCreaturesFabric"
    ],
    "client": [
      "andrews.pandoras_creatures.client.PandorasCreaturesFabricClient"
    ]
  },
  "mixins": [
    "pandoras_creatures.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
