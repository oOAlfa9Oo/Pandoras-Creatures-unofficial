package andrews.pandoras_creatures.client.model.base;

import com.mojang.blaze3d.vertex.PoseStack;
import com.mojang.blaze3d.vertex.VertexConsumer;
import it.unimi.dsi.fastutil.objects.ObjectArrayList;
import it.unimi.dsi.fastutil.objects.ObjectList;
import net.minecraft.client.model.geom.ModelPart;
import net.minecraft.util.Mth;
import net.neoforged.api.distmarker.Dist;
import net.neoforged.api.distmarker.OnlyIn;

/**
 * Extended ModelPart with custom scaling support and animation helpers
 * Ported from PCModelRenderer (1.16.5) to work with 1.21.1 NeoForge
 *
 * @author SmellyModder(Luke Tonon) - Original PCModelRenderer
 * Ported to 1.21.1 by maintaining compatibility with the custom animation system
 */
@OnlyIn(Dist.CLIENT)
public class PCModelPart extends ModelPart {
    public float defaultX, defaultY, defaultZ;
    public float defaultXRot, defaultYRot, defaultZRot;
    public boolean scaleChildren = true;
    public float[] scales = {1.0F, 1.0F, 1.0F};

    private final ObjectList<PCModelPart> pcChildren = new ObjectArrayList<>();

    public PCModelPart(ModelPart.Cube cube) {
        super(new ObjectArrayList<>(), new ObjectArrayList<>());
    }

    /**
     * Creates a PCModelPart from an existing ModelPart
     * This allows wrapping standard ModelPart instances with scaling functionality
     */
    public static PCModelPart fromModelPart(ModelPart modelPart) {
        // Create a new PCModelPart by copying the ModelPart's properties
        PCModelPart pcPart = new PCModelPart(null);
        pcPart.x = modelPart.x;
        pcPart.y = modelPart.y;
        pcPart.z = modelPart.z;
        pcPart.xRot = modelPart.xRot;
        pcPart.yRot = modelPart.yRot;
        pcPart.zRot = modelPart.zRot;
        pcPart.visible = modelPart.visible;
        return pcPart;
    }

    public void addChild(PCModelPart child) {
        this.pcChildren.add(child);
    }

    /**
     * Sets the default box values for animation reset
     */
    public void setDefaultBoxValues() {
        this.defaultX = this.x;
        this.defaultY = this.y;
        this.defaultZ = this.z;

        this.defaultXRot = this.xRot;
        this.defaultYRot = this.yRot;
        this.defaultZRot = this.zRot;
    }

    /**
     * Reverts the current box's values back to the default values
     */
    public void revertToDefaultBoxValues() {
        this.x = this.defaultX;
        this.y = this.defaultY;
        this.z = this.defaultZ;

        this.xRot = this.defaultXRot;
        this.yRot = this.defaultYRot;
        this.zRot = this.defaultZRot;
    }

    // ===============================================================================
    // Scaling Related Stuff
    // ===============================================================================

    /**
     * Sets the scale
     */
    public void setScale(float x, float y, float z) {
        this.scales[0] = x;
        this.scales[1] = y;
        this.scales[2] = z;
    }

    /**
     * Sets the scale of the X axis on this ModelPart
     * @param scaleX - Value of scale
     */
    public void setScaleX(float scaleX) {
        this.scales[0] = scaleX;
    }

    /**
     * Sets the scale of the Y axis on this ModelPart
     * @param scaleY - Value of scale
     */
    public void setScaleY(float scaleY) {
        this.scales[1] = scaleY;
    }

    /**
     * Sets the scale of the Z axis on this ModelPart
     * @param scaleZ - Value of scale
     */
    public void setScaleZ(float scaleZ) {
        this.scales[2] = scaleZ;
    }

    public void setShouldScaleChildren(boolean scaleChildren) {
        this.scaleChildren = scaleChildren;
    }

    // ===============================================================================
    // Rendering with Scaling Support
    // ===============================================================================

    @Override
    public void render(PoseStack poseStack, VertexConsumer consumer, int packedLight, int packedOverlay) {
        render(poseStack, consumer, packedLight, packedOverlay, 0xFFFFFFFF);
    }

    @Override
    public void render(PoseStack poseStack, VertexConsumer consumer, int packedLight, int packedOverlay, int color) {
        if (this.visible) {
            if (!this.isEmpty()) {
                poseStack.pushPose();
                this.translateAndRotate(poseStack);

                if (this.scaleChildren) {
                    poseStack.scale(this.scales[0], this.scales[1], this.scales[2]);
                    this.compile(poseStack.last(), consumer, packedLight, packedOverlay, color);

                    for (PCModelPart child : this.pcChildren) {
                        child.render(poseStack, consumer, packedLight, packedOverlay, color);
                    }
                } else {
                    poseStack.pushPose();
                    poseStack.scale(this.scales[0], this.scales[1], this.scales[2]);
                    this.compile(poseStack.last(), consumer, packedLight, packedOverlay, color);
                    poseStack.popPose();

                    for (PCModelPart child : this.pcChildren) {
                        child.render(poseStack, consumer, packedLight, packedOverlay, color);
                    }
                }
                poseStack.popPose();
            }
        }
    }

    // ===============================================================================
    // Looped Animation Methods
    // ===============================================================================

    private float calculateRotation(float speed, float degree, boolean invert, float delay, float weight, float limbSwing, float limbSwingAmount) {
        if (invert) {
            float rotation = (Mth.cos(limbSwing * speed + delay) * degree * limbSwingAmount) - (weight * limbSwingAmount);
            return -rotation;
        } else {
            float rotation = (Mth.cos(limbSwing * speed + delay) * degree * limbSwingAmount) + (weight * limbSwingAmount);
            return rotation;
        }
    }

    /**
     * Rotates this box back and forth (xRot)
     */
    public void swing(float speed, float degree, boolean invert, float delay, float weight, float limbSwing, float limbSwingAmount) {
        this.xRot += this.calculateRotation(speed, degree, invert, delay, weight, limbSwing, limbSwingAmount);
    }

    /**
     * Rotates this box right and left (zRot)
     */
    public void flap(float speed, float degree, boolean invert, float delay, float weight, float limbSwing, float limbSwingAmount) {
        this.zRot += this.calculateRotation(speed, degree, invert, delay, weight, limbSwing, limbSwingAmount);
    }

    /**
     * Rotates this box side to side (yRot)
     */
    public void shake(float speed, float degree, boolean invert, float delay, float weight, float limbSwing, float limbSwingAmount) {
        this.yRot += this.calculateRotation(speed, degree, invert, delay, weight, limbSwing, limbSwingAmount);
    }

    /**
     * This makes the given Box move Up and Down on the Y Axis
     */
    public void bounce(float speed, float height, boolean extraBouncy, float limbSwing, float limbSwingAmount) {
        float bounce = (float) (Math.sin(limbSwing * speed) * limbSwingAmount * height - limbSwingAmount * height);
        if (extraBouncy) {
            bounce = (float) -Math.abs((Math.sin(limbSwing * speed) * limbSwingAmount * height));
        }
        this.y += bounce;
    }
}
